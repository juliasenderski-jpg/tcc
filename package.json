{
  "name": "reino-do-dragao-backend",
  "version": "1.4.0",
  "description": "Sistema integrado de reservas com auditoria, backup e testes de regras de negócio",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node scripts/check.js",
    "test": "node --test tests/*.test.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mysql2": "^3.12.0"
  }
}
